# ─────────────────────────────────────────────────────────────────────────────
# One template for every environment. Copy to .env, then run: php artisan key:generate
# Values below are for LOCAL development. Lines marked "PRODUCTION:" show what
# to use on the live server (staging = same as production, with APP_ENV=staging).
# After changing .env on the server, run: php artisan optimize
# ─────────────────────────────────────────────────────────────────────────────

APP_NAME=SelfBuy
# PRODUCTION: production   (local | staging | production)
APP_ENV=local
# PRODUCTION: generate a new one on the server - never reuse the local key
APP_KEY=
# PRODUCTION: false  (true shows code, queries and .env values on any error)
APP_DEBUG=false
APP_TIMEZONE=UTC
# PRODUCTION: https://your-domain.com  (used in emails and payment return URLs)
APP_URL=http://selfbuy.com
# https:// links + secure session cookie. Both default to true only when APP_ENV=production.
# APP_FORCE_HTTPS=false
# SESSION_SECURE_COOKIE=false

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
SESSION_EXPIRE_ON_CLOSE=false
#SESSION_COOKIE=

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
# PRODUCTION: daily,bugsnag  (daily = one file per day, files older than LOG_DAILY_DAYS
# deleted; bugsnag = errors also sent to Bugsnag, see BUGSNAG_* below)
LOG_STACK=single
LOG_DAILY_DAYS=14
LOG_DEPRECATIONS_CHANNEL=null
# PRODUCTION: error
LOG_LEVEL=debug

# DB_CONNECTION=sqlite
DB_CONNECTION=mysql
# PRODUCTION: the live database details, with a dedicated user (not root)
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=selfbuy
DB_USERNAME=
DB_PASSWORD=

# SESSION_DRIVER=database
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

# file is fine on a single server; use redis if you run more than one app server
CACHE_STORE=file
# PRODUCTION: selfbuy_
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# PRODUCTION: smtp + real MAIL_* details below. Login OTPs are sent by email -
# with "log" customers never receive their code and cannot sign in.
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
# PRODUCTION: no-reply@your-domain.com
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Telescope only loads when APP_ENV=local. PRODUCTION: false
TELESCOPE_ENABLED=true

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# PRODUCTION: also add https://your-domain.com/auth/google/callback in Google Cloud Console
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"

MSG91_AUTH_KEY=your_auth_key
MSG91_OTP_TEMPLATE_ID=your_template_id
MSG91_SENDER_ID=your_sender_id
# Separate from MSG91_OTP_TEMPLATE_ID — a DLT-registered template for general
# (non-OTP) transactional SMS like order confirmations, required in India.
MSG91_TRANSACTIONAL_TEMPLATE_ID=your_transactional_template_id

# SMS_DRIVER=log writes OTP codes to storage/logs/laravel.log instead of sending a
# real SMS. Switch to SMS_DRIVER=msg91 once the MSG91_* keys above are real.
SMS_DRIVER=log
# MSG91_OTP_URL=https://control.msg91.com/api/v5/otp
# MSG91_FLOW_URL=https://control.msg91.com/api/v5/flow/

# Error monitoring - Bugsnag dashboard > Project settings > Notifier API key.
# Only reports from APP_ENV=production/staging (BUGSNAG_NOTIFY_RELEASE_STAGES), and only
# errors logged to the "bugsnag" channel - add it to LOG_STACK on the server.
# PRODUCTION: your project's API key
BUGSNAG_API_KEY=
# BUGSNAG_NOTIFY_RELEASE_STAGES=production,staging
# BUGSNAG_LOGGER_LEVEL=error

# Optional remote logging (LogDNAService)
LOGDNA_INGESTION_KEY=
# LOGDNA_URL=https://logs.logdna.com/logs/ingest

# Razorpay TEST MODE credentials (from Dashboard > Settings > API Keys, with
# "Test Mode" toggled on). RAZORPAY_WEBHOOK_SECRET is a separate value you set
# yourself when creating the webhook (Dashboard > Settings > Webhooks) — not
# the same as the key secret above.
# PAYMENTS: test/sandbox keys on every environment for now. To go live later,
# swap in live keys and set PAYPAL_SANDBOX / INSTAMOJO_SANDBOX to false - no code change.
# PRODUCTION: re-create each webhook pointing at https://your-domain.com/webhooks/{gateway}
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Stripe TEST MODE credentials (Dashboard > Developers > API Keys, with the
# "Test mode" toggle on). STRIPE_WEBHOOK_SECRET is a separate value from the
# "Reveal" webhook signing secret (Dashboard > Developers > Webhooks) — or,
# for local testing, whatever `stripe listen` prints when it starts.
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=

# PayPal SANDBOX credentials (Developer Dashboard > Apps & Credentials, Sandbox
# tab). PAYPAL_MERCHANT_ID is only needed for a platform/multi-seller app —
# leave blank for a standard single-account integration. PAYPAL_WEBHOOK_ID
# comes from Dashboard > Webhooks after creating a webhook subscription there
# (separate from the client id/secret, needed only for the /webhooks/paypal route).
PAYPAL_SANDBOX=true
# API base URLs - PAYPAL_SANDBOX above picks which one is used. Defaults are in config/services.php.
# PAYPAL_SANDBOX_API_URL=https://api-m.sandbox.paypal.com
# PAYPAL_LIVE_API_URL=https://api-m.paypal.com
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MERCHANT_ID=
PAYPAL_WEBHOOK_ID=

# PayPal can't receive INR on an India-registered business account, so PayPal
# checkouts are charged in USD instead (converted from the cart's INR total —
# see ExchangeRateService/PaymentService::initiate()). This fallback rate is
# only used if the live rate lookup fails; update it occasionally.
EXCHANGE_RATE_INR_USD_FALLBACK=0.012
# EXCHANGE_RATE_URL=https://open.er-api.com/v6/latest/INR

# Instamojo TEST MODE credentials (Dashboard > Settings > API & Auth Tokens
# on test.instamojo.com). "Private key" = API Key, "private auth token" =
# Auth Token — both used to authenticate requests. INSTAMOJO_SALT is the
# separate private Salt used only to verify webhook signatures.
INSTAMOJO_SANDBOX=true
# API base URLs - INSTAMOJO_SANDBOX above picks which one is used. Defaults are in config/services.php.
# INSTAMOJO_SANDBOX_API_URL=https://test.instamojo.com/api/1.1
# INSTAMOJO_LIVE_API_URL=https://www.instamojo.com/api/1.1
INSTAMOJO_API_KEY=
INSTAMOJO_AUTH_TOKEN=
INSTAMOJO_SALT=
ADMIN_REGISTRATION_ENABLED=false
