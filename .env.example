APP_NAME=SelfBuy
APP_ENV=local
APP_KEY=base64:EdwIvQySua7wM5ieLi6VEphD1du0FKAUkAyDHrC/BRc=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://selfbuy.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
SESSION_EXPIRE_ON_CLOSE=false
#SESSION_COOKIE=

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# DB_CONNECTION=sqlite
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=selfbuy
DB_USERNAME=
DB_PASSWORD=

# SESSION_DRIVER=database
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

# file for local dev; redis in production (needs a Redis server + REDIS_* below)
CACHE_STORE=file
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"

MSG91_AUTH_KEY=your_auth_key
MSG91_OTP_TEMPLATE_ID=your_template_id
MSG91_SENDER_ID=your_sender_id
# Separate from MSG91_OTP_TEMPLATE_ID — a DLT-registered template for general
# (non-OTP) transactional SMS like order confirmations, required in India.
MSG91_TRANSACTIONAL_TEMPLATE_ID=your_transactional_template_id

# SMS_DRIVER=log writes OTP codes to storage/logs/laravel.log instead of sending a
# real SMS. Switch to SMS_DRIVER=msg91 once the MSG91_* keys above are real.
SMS_DRIVER=log

# Razorpay TEST MODE credentials (from Dashboard > Settings > API Keys, with
# "Test Mode" toggled on). RAZORPAY_WEBHOOK_SECRET is a separate value you set
# yourself when creating the webhook (Dashboard > Settings > Webhooks) — not
# the same as the key secret above.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Stripe TEST MODE credentials (Dashboard > Developers > API Keys, with the
# "Test mode" toggle on). STRIPE_WEBHOOK_SECRET is a separate value from the
# "Reveal" webhook signing secret (Dashboard > Developers > Webhooks) — or,
# for local testing, whatever `stripe listen` prints when it starts.
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=

# PayPal SANDBOX credentials (Developer Dashboard > Apps & Credentials, Sandbox
# tab). PAYPAL_MERCHANT_ID is only needed for a platform/multi-seller app —
# leave blank for a standard single-account integration. PAYPAL_WEBHOOK_ID
# comes from Dashboard > Webhooks after creating a webhook subscription there
# (separate from the client id/secret, needed only for the /webhooks/paypal route).
PAYPAL_SANDBOX=true
PAYPAL_SANDBOX_URL=https://sandbox.paypal.com
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MERCHANT_ID=
PAYPAL_WEBHOOK_ID=

# PayPal can't receive INR on an India-registered business account, so PayPal
# checkouts are charged in USD instead (converted from the cart's INR total —
# see ExchangeRateService/PaymentService::initiate()). This fallback rate is
# only used if the live rate lookup fails; update it occasionally.
EXCHANGE_RATE_INR_USD_FALLBACK=0.012

# Instamojo TEST MODE credentials (Dashboard > Settings > API & Auth Tokens
# on test.instamojo.com). "Private key" = API Key, "private auth token" =
# Auth Token — both used to authenticate requests. INSTAMOJO_SALT is the
# separate private Salt used only to verify webhook signatures.
INSTAMOJO_SANDBOX=true
INSTAMOJO_API_KEY=
INSTAMOJO_AUTH_TOKEN=
INSTAMOJO_SALT=
ADMIN_REGISTRATION_ENABLED=false
